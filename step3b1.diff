diff -ruN a/backend/test/dev-seed.test.js b/backend/test/dev-seed.test.js
--- a/backend/test/dev-seed.test.js	1970-01-01 00:00:00.000000000 +0000
+++ b/backend/test/dev-seed.test.js	2026-10-26 12:43:45.349976466 +0000
@@ -0,0 +1,66 @@
+// ทดสอบบัญชีทดลองในเครื่อง
+// รัน: SQLITE_PATH=:memory: node test/dev-seed.test.js
+process.env.SQLITE_PATH = ":memory:";
+process.env.DB_DRIVER = "sqlite";
+delete process.env.NODE_ENV;
+
+const assert = require("node:assert/strict");
+const db = require("../db");
+const users = require("../repo/users");
+const { seedDevAccounts } = require("../repo/dev-seed");
+
+let passed = 0;
+async function check(name, fn) {
+  await fn();
+  passed++;
+  console.log("  ✓", name);
+}
+
+(async () => {
+  await db.init();
+
+  await check("สร้าง 5 บัญชี, รันซ้ำไม่สร้างซ้ำ", async () => {
+    assert.equal((await seedDevAccounts()).created.length, 5);
+    assert.equal((await seedDevAccounts()).created.length, 0);
+    assert.equal((await users.list()).length, 5);
+  });
+
+  await check("ล็อกอินด้วยอีเมล + 1234 ได้ทุกบัญชี รหัสผิดไม่ได้", async () => {
+    for (const email of [
+      "admin@example.com", "somchai@example.com", "wipa@example.com",
+      "67070999@kmitl.ac.th", "67010888@kmitl.ac.th",
+    ]) {
+      assert.ok(await users.authenticate(email, "1234"), email);
+      assert.equal(await users.authenticate(email, "0000"), null);
+    }
+  });
+
+  await check("คณะ/units ถูกต้อง", async () => {
+    assert.equal((await users.findByEmail("67070999@kmitl.ac.th")).faculty_id, "07");
+    assert.equal((await users.findByEmail("67010888@kmitl.ac.th")).faculty_id, "01");
+    assert.deepEqual((await users.findByEmail("somchai@example.com")).units,
+      [{ faculty_id: "07", department_id: "it" }]);
+    assert.deepEqual((await users.findByEmail("wipa@example.com")).units,
+      [{ faculty_id: "07", department_id: "building" }]);
+  });
+
+  await check("รหัสผ่านใน DB เป็น hash ไม่ใช่ 1234", async () => {
+    const rows = await db.query("SELECT password_hash FROM users");
+    for (const r of rows) assert.ok(r.password_hash.startsWith("scrypt$"));
+  });
+
+  await check("production: ไม่สร้างบัญชีทดลอง", async () => {
+    await db.query("DELETE FROM user_units");
+    await db.query("DELETE FROM users");
+    process.env.NODE_ENV = "production";
+    const r = await seedDevAccounts();
+    assert.equal(r.skipped, true);
+    assert.equal((await users.list()).length, 0);
+  });
+
+  console.log(`\nผ่านทั้งหมด ${passed} ข้อ`);
+  await db.close();
+})().catch((e) => {
+  console.error("\n✗ ล้มเหลว:", e);
+  process.exitCode = 1;
+});
diff -ruN a/backend/test/users.repo.test.js b/backend/test/users.repo.test.js
--- a/backend/test/users.repo.test.js	1970-01-01 00:00:00.000000000 +0000
+++ b/backend/test/users.repo.test.js	2026-10-26 12:43:45.345771138 +0000
@@ -0,0 +1,143 @@
+// ทดสอบ repo/users.js บน SQLite ในหน่วยความจำ
+// รัน: SQLITE_PATH=:memory: node test/users.repo.test.js
+process.env.SQLITE_PATH = ":memory:";
+process.env.DB_DRIVER = "sqlite";
+
+const assert = require("node:assert/strict");
+const db = require("../db");
+const users = require("../repo/users");
+
+let passed = 0;
+async function check(name, fn) {
+  await fn();
+  passed++;
+  console.log("  ✓", name);
+}
+
+(async () => {
+  await db.init();
+  // init ซ้ำต้องไม่พัง (idempotent)
+  await db.init();
+
+  await check("faculties: 16 เดิม + 21 + 00 + 99 = 19 แถว, ไม่มี 015", async () => {
+    const f = await users.listFaculties();
+    assert.equal(f.length, 19);
+    const ids = f.map((x) => x.id);
+    for (const id of ["00", "21", "99", "01", "11", "12"]) assert.ok(ids.includes(id), id);
+    assert.ok(!ids.includes("015"));
+  });
+
+  await check("departments: 5 หน่วยงานครบ", async () => {
+    const d = (await users.listDepartments()).map((x) => x.id).sort();
+    assert.deepEqual(d, ["academic", "activities", "building", "it", "student"]);
+  });
+
+  await check("หาคณะจากรหัสนักศึกษา (07→IT, 01→วิศวะ, 21→โคเซ็น, 015 ไม่แยก)", async () => {
+    assert.equal((await users.facultyFromStudentId("67070223")).id, "07");
+    assert.equal((await users.facultyFromStudentId("67010888")).id, "01");
+    assert.equal((await users.facultyFromStudentId("67210001")).name, "โคเซ็น");
