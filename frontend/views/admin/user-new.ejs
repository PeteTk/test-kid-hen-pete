<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KIDHEN | เพิ่มผู้ใช้</title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-[#EEEDEA]">
  <%
    // เพิ่ม (3b-3): Admin เพิ่มผู้ใช้ (UC-09)
    const ROLE_LABEL = { ADMIN: "Admin", STAFF: "Staff", USER: "User" };
    const units = form.units && form.units.length ? form.units : [{ faculty_id: "", department_id: "" }];
    const inputClass = "w-full h-10 px-4 rounded-lg border border-gray-500 text-sm focus:outline-none focus:ring-2 focus:ring-[#1F2A8A]";
  %>

  <div class="flex min-h-screen">
    <%- include("../partials/sidebar-admin") %>

    <main class="flex-1">
      <%- include("../partials/topbar") %>

      <section class="p-4">
        <div class="bg-white p-6 min-h-[660px] flex flex-col">

          <a href="/admin/users" title="ย้อนกลับ"
             class="w-9 h-9 rounded-full bg-[#F6A85A] flex items-center justify-center hover:opacity-80">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="black"
                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
          </a>

          <div class="flex items-center justify-between mt-2 pb-3 border-b-4 border-[#EEEDEA]">
            <h2 class="text-xl font-bold text-[#1F2A8A]">เพิ่มผู้ใช้</h2>
          </div>

          <% if (error) { %>
            <p class="mt-3 text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-4 py-2">
              <%= error %>
            </p>
          <% } %>

          <form method="POST" action="/admin/users/new" class="flex-1 flex flex-col">
            <div class="flex flex-col gap-5 mt-8 w-full max-w-[900px] mx-auto">

              <div>
                <label for="email" class="block text-xs font-semibold mb-1">อีเมล</label>
                <input id="email" name="email" type="email" required maxlength="254"
                       value="<%= form.email %>" placeholder="เช่น 67070001@kmitl.ac.th" class="<%= inputClass %>">
                <p class="text-xs text-gray-400 mt-1">
                  <% if (localAuth) { %>
                    ใช้อีเมลนี้เข้าสู่ระบบ
                  <% } else { %>
                    ระบบส่งรหัสผ่านชั่วคราวไปที่อีเมลนี้ (ครั้งแรกต้องตั้งรหัสใหม่) หรือผู้ใช้กด Continue with Google ด้วยอีเมลเดียวกันได้
                  <% } %>
                </p>
              </div>

              <div>
                <label for="name" class="block text-xs font-semibold mb-1">ชื่อ-นามสกุล</label>
                <input id="name" name="name" type="text" required maxlength="150"
                       value="<%= form.name %>" class="<%= inputClass %>">
              </div>

              <% if (localAuth) { %>
                <div>
                  <label for="password" class="block text-xs font-semibold mb-1">รหัสผ่าน</label>
                  <input id="password" name="password" type="text" required minlength="4" autocomplete="off"
                         class="<%= inputClass %>">
                  <p class="text-xs text-gray-400 mt-1">โหมดในเครื่อง (ไม่ต่อ Cognito)</p>
                </div>
              <% } %>

              <div class="w-1/2 pr-3">
                <label for="role" class="block text-xs font-semibold mb-1">บทบาท</label>
                <select id="role" name="role" class="<%= inputClass %> bg-white">
                  <% ROLES.forEach(r => { %>
                    <option value="<%= r %>" <%= form.role === r ? 'selected' : '' %>><%= ROLE_LABEL[r] %></option>
                  <% }) %>
                </select>
              </div>

              <!-- นักศึกษา: คณะจากรหัสในอีเมล -->
              <p id="studentNote" class="text-xs text-gray-400">นักศึกษา: ระบุคณะอัตโนมัติจากรหัสนักศึกษาในอีเมล</p>

              <!-- Staff / Admin: คณะ + ฝ่าย -->
              <div id="unitBox">
                <div class="grid grid-cols-2 gap-6 mb-1">
                  <span class="text-xs font-semibold">คณะ</span>
                  <span class="text-xs font-semibold">ฝ่าย</span>
                </div>
                <div id="units" class="flex flex-col gap-3">
                  <% units.forEach((u, i) => { %>
                    <div class="unit-row relative grid grid-cols-2 gap-6">
                      <select name="faculty[]" class="<%= inputClass %> bg-white">
                        <option value="">เลือกคณะ</option>
                        <% FACULTIES.forEach(f => { %>
                          <option value="<%= f.id %>" <%= u.faculty_id === f.id ? 'selected' : '' %>><%= f.id %> <%= f.name %></option>
                        <% }) %>
                      </select>
                      <select name="department[]" class="<%= inputClass %> bg-white">
                        <option value="">เลือกฝ่าย</option>
                        <% DEPARTMENTS.forEach(d => { %>
                          <option value="<%= d.id %>" <%= u.department_id === d.id ? 'selected' : '' %>><%= d.name %></option>
                        <% }) %>
                      </select>
                      <% if (i > 0) { %>
                        <button type="button" onclick="this.parentElement.remove()" title="ลบแถวนี้"
                                class="absolute -right-8 top-2 w-6 h-6 rounded-full text-gray-400 hover:bg-red-50 hover:text-red-600">✕</button>
                      <% } %>
                    </div>
                  <% }) %>
                </div>
                <button type="button" id="addUnit"
                        class="mt-3 px-3 py-0.5 rounded-full bg-[#E2E2E2] text-xs font-semibold hover:bg-[#D2D2D2]">
                  เพิ่ม +
                </button>
                <p class="text-xs text-gray-400 mt-1">Staff ต้องมีคณะเดียว (เลือกได้หลายฝ่าย) · Admin ไม่บังคับ</p>
              </div>
            </div>

            <div class="mt-auto pt-10 flex justify-end gap-6">
              <a href="/admin/users"
                 class="w-[150px] h-10 rounded-full border border-black bg-[#D9D9D9] font-bold flex items-center justify-center hover:bg-[#C9C9C9]">
                ยกเลิก
              </a>
              <button type="submit"
                      class="w-[150px] h-10 rounded-full border border-black bg-[#F6A85A] font-bold hover:bg-[#F39A3E]">
                เพิ่มผู้ใช้
              </button>
            </div>
          </form>

        </div>
      </section>
    </main>
  </div>

  <script>
    // แสดงช่องคณะ/ฝ่ายเฉพาะ Staff / Admin
    const roleSelect = document.getElementById("role");
    function toggleUnits() {
      const student = roleSelect.value === "USER";
      document.getElementById("unitBox").classList.toggle("hidden", student);
      document.getElementById("studentNote").classList.toggle("hidden", !student);
      document.querySelectorAll("#unitBox select").forEach((s) => (s.disabled = student));
    }
    roleSelect.addEventListener("change", toggleUnits);
    toggleUnits();

    document.getElementById("addUnit").addEventListener("click", () => {
      const units = document.getElementById("units");
      const row = units.querySelector(".unit-row").cloneNode(true);
      row.querySelectorAll("select").forEach((select) => (select.selectedIndex = 0));
      row.querySelector("button")?.remove();
      const removeBtn = document.createElement("button");
      removeBtn.type = "button";
      removeBtn.title = "ลบแถวนี้";
      removeBtn.textContent = "✕";
      removeBtn.className = "absolute -right-8 top-2 w-6 h-6 rounded-full text-gray-400 hover:bg-red-50 hover:text-red-600";
      removeBtn.addEventListener("click", () => row.remove());
      row.appendChild(removeBtn);
      units.appendChild(row);
    });
  </script>
</body>
</html>
