<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KIDHEN | <%= title %></title>
  <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-[#EEEDEA]">

<div class="flex min-h-screen">
  <%- include("../partials/sidebar-admin") %>

  <main class="flex-1 min-w-0">
    <%- include("../partials/topbar") %>

    <section class="p-4 lg:p-6 flex flex-col gap-4">

      <!-- ข้อความแจ้งผล -->
      <% if (flash) { %>
        <p role="status"
           class="px-4 py-3 rounded-lg border text-sm
                  <%= flash.error
                    ? 'bg-red-50 border-red-200 text-red-600'
                    : 'bg-[#E3FBD2] border-[#8BDA5B] text-[#3A8A12]' %>">
          <%= flash.text %>
        </p>
      <% } %>

      <!-- ===== สถานะ scheduler และรอบล่าสุด ===== -->
      <div class="bg-white rounded-2xl p-4 lg:p-6">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">

          <div class="min-w-0">
            <h2 class="font-bold text-[#1F2A8A] text-lg lg:text-xl">สรุปปัญหาอัตโนมัติรายสัปดาห์</h2>
            <p class="mt-1 text-sm text-gray-600">จัดกลุ่มเพื่อแสดงภาพรวม ไม่รวมงานหรือปิดคำร้องอัตโนมัติ</p>
          </div>

          <form method="POST" action="/admin/faq/run" class="shrink-0">
            <input type="hidden" name="_csrf" value="<%= aiCsrf %>">
            <button <%= running ? "disabled" : "" %>
                    class="w-full md:w-auto bg-[#F6A85A] rounded-full px-6 py-2.5 font-semibold
                           hover:bg-[#F39A3E] disabled:opacity-50 disabled:cursor-not-allowed">
              <%= running ? "กำลังประมวลผล..." : "ประมวลผลตอนนี้" %>
            </button>
          </form>
        </div>

        <!-- ข้อมูลสถานะ -->
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 text-sm">
          <div class="rounded-xl bg-[#F7F8FB] px-4 py-3">
            <p class="mt-2 text-sm">
              การตั้งเวลา:
              จัดการผ่าน AWS EventBridge Scheduler
            </p>

            <p class="mt-2 text-sm">
              การรับงานของเว็บ:
              <%= eventBridgeConfigured
                ? "ตั้ง API Key แล้ว"
                : "ยังไม่ได้ตั้ง API Key" %>
            </p>

            <p class="mt-2 text-xs text-gray-500">
              ตรวจวันเวลาและสถานะ Enabled
              ของ Schedule ใน AWS Console
            </p>
          </div>

          <div class="rounded-xl bg-[#F7F8FB] px-4 py-3">
            <p class="text-xs text-gray-500">สถานะ</p>
            <p class="font-semibold mt-1 <%= running ? 'text-[#E07B12]' : 'text-[#3A8A12]' %>">
              <%= running ? "กำลังประมวลผล — กดรีเฟรชเพื่อตรวจผล" : "พร้อมทำงาน" %>
            </p>
          </div>

          <% if (lastRun) { %>
            <div class="rounded-xl bg-[#F7F8FB] px-4 py-3 sm:col-span-2 lg:col-span-1">
              <p class="text-xs text-gray-500">รอบล่าสุด</p>
              <p class="font-semibold mt-1">
                <%= formatThaiDate(lastRun.finishedAt) %>
                · <span class="<%= lastRun.success ? 'text-[#3A8A12]' : 'text-red-600' %>">
                    <%= lastRun.success ? "สำเร็จ" : "ไม่สำเร็จ" %>
                  </span>
              </p>
              <p class="text-xs text-gray-500 mt-1">
                ประมวลผล <%= lastRun.processed %> คำร้อง · เก็บภายในเพิ่ม <%= lastRun.heldCount %> คำร้อง
              </p>
            </div>
          <% } %>
        </div>

        <% if (lastRun && !lastRun.success) { %>
          <p class="mt-3 text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-4 py-2 break-words">
            <%= lastRun.error %>
          </p>
        <% } %>

        <p class="mt-3 text-xs text-gray-500">
          ปุ่มนี้เรียก Gemini จริง เฉพาะข้อมูลใหม่/เปลี่ยน และไม่เปลี่ยนวันเวลารอบประจำ
        </p>
      </div>

      <!-- ===== ค้นหาและกรอง ===== -->
      <form method="GET" action="/admin/faq"
            class="grid grid-cols-2 md:flex md:flex-wrap md:items-center gap-3">

        <input name="q" value="<%= filters.q %>" placeholder="ค้นหาหัวข้อ"
               class="col-span-2 md:w-[320px] h-11 px-4 bg-white border border-gray-400 rounded-lg text-sm
                      focus:outline-none focus:ring-2 focus:ring-[#1F2A8A]">

        <select name="type"
                class="h-11 px-3 bg-white border border-gray-400 rounded-lg text-sm md:w-[180px]">
          <option value="">ทุกประเภท</option>
          <% TYPES.forEach(t => { %>
            <option <%= filters.type === t ? "selected" : "" %>><%= t %></option>
          <% }) %>
        </select>

        <select name="status"
                class="h-11 px-3 bg-white border border-gray-400 rounded-lg text-sm md:w-[200px]">
          <option value="">ทุกสถานะการเผยแพร่</option>
          <option value="published" <%= filters.status === "published" ? "selected" : "" %>>เผยแพร่แล้ว</option>
          <option value="hidden" <%= filters.status === "hidden" ? "selected" : "" %>>ซ่อนอยู่</option>
        </select>

        <button class="col-span-2 md:col-span-1 h-11 bg-[#1F2A8A] text-white rounded-lg px-6 text-sm font-semibold
                       hover:bg-[#18226F]">
          ค้นหา
        </button>
      </form>

      <!-- ===== รายการหัวข้อ ===== -->
      <div class="bg-white rounded-2xl p-4 lg:p-6">

        <% if (!list.length) { %>
          <p class="py-10 text-center text-gray-500">ยังไม่มีสรุป กดประมวลผลตอนนี้เพื่อทดสอบ</p>
        <% } else { %>

          <!-- คอม / แท็บเล็ต: ตาราง -->
          <div class="hidden md:block overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b-2 border-gray-300 text-left text-gray-500">
                  <th class="p-3 font-medium">หัวข้อ</th>
                  <th class="p-3 font-medium whitespace-nowrap">สถานะคำร้อง</th>
                  <th class="p-3 font-medium whitespace-nowrap">การเผยแพร่</th>
                  <th class="p-3 font-medium text-center">จัดการ</th>
                </tr>
              </thead>
              <tbody>
                <% list.forEach(t => { %>
                  <tr class="border-b border-gray-200 hover:bg-[#F7F8FB]">
                    <td class="p-3">
                      <p class="font-semibold"><%= t.title %></p>
                      <p class="text-xs text-gray-500 mt-1">
                        <%= t.type %> · <%= t.location %> · <%= t.people %> คน / <%= t.count %> คำร้อง
                      </p>
                    </td>

                    <td class="p-3">
                      <div class="flex flex-wrap gap-1.5">
                        <span class="px-2 py-0.5 rounded-full text-xs bg-[#E3EEFF] text-[#1F4FB5] whitespace-nowrap">รอ <%= t.counts["รอดำเนินการ"] %></span>
                        <span class="px-2 py-0.5 rounded-full text-xs bg-[#FFE9D6] text-[#E07B12] whitespace-nowrap">กำลังทำ <%= t.counts["กำลังดำเนินการ"] %></span>
                        <span class="px-2 py-0.5 rounded-full text-xs bg-[#E3FBD2] text-[#3A8A12] whitespace-nowrap">เสร็จ <%= t.counts["เสร็จสิ้น"] %></span>
                      </div>
                    </td>

                    <td class="p-3">
                      <span class="inline-block px-3 py-0.5 rounded-full text-xs whitespace-nowrap
                                   <%= t.published ? 'bg-[#E3FBD2] text-[#3A8A12]' : 'bg-gray-100 text-gray-500' %>">
                        <%= t.published ? "เผยแพร่แล้ว" : "ซ่อนอยู่" %>
                      </span>
                    </td>

                    <td class="p-3 text-center">
                      <a href="/admin/faq/topics/<%= t.id %>"
                         class="inline-block px-3 py-1 rounded-md border border-gray-500 bg-white text-xs font-semibold whitespace-nowrap hover:bg-gray-100">
                        ดูและแก้ไข
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <!-- มือถือ: การ์ด -->
          <div class="md:hidden flex flex-col gap-3">
            <% list.forEach(t => { %>
              <a href="/admin/faq/topics/<%= t.id %>"
                 class="block rounded-xl border border-gray-200 p-4 hover:bg-gray-50 active:bg-gray-100">
                <div class="flex items-start justify-between gap-2">
                  <p class="font-bold"><%= t.title %></p>
                  <span class="shrink-0 px-2.5 py-0.5 rounded-full text-xs whitespace-nowrap
                               <%= t.published ? 'bg-[#E3FBD2] text-[#3A8A12]' : 'bg-gray-100 text-gray-500' %>">
                    <%= t.published ? "เผยแพร่แล้ว" : "ซ่อนอยู่" %>
                  </span>
                </div>

                <p class="text-xs text-gray-500 mt-1">
                  <%= t.type %> · <%= t.location %> · <%= t.people %> คน / <%= t.count %> คำร้อง
                </p>

                <div class="flex flex-wrap gap-1.5 mt-3">
                  <span class="px-2 py-0.5 rounded-full text-xs bg-[#E3EEFF] text-[#1F4FB5]">รอ <%= t.counts["รอดำเนินการ"] %></span>
                  <span class="px-2 py-0.5 rounded-full text-xs bg-[#FFE9D6] text-[#E07B12]">กำลังทำ <%= t.counts["กำลังดำเนินการ"] %></span>
                  <span class="px-2 py-0.5 rounded-full text-xs bg-[#E3FBD2] text-[#3A8A12]">เสร็จ <%= t.counts["เสร็จสิ้น"] %></span>
                </div>

                <p class="text-right text-xs font-semibold text-[#1F2A8A] mt-3">ดูและแก้ไข →</p>
              </a>
            <% }) %>
          </div>

        <% } %>
      </div>

      <!-- ===== คำร้องที่เก็บภายใน ===== -->
      <details class="bg-white rounded-2xl p-4 lg:p-6">
        <summary class="cursor-pointer font-semibold">
          คำร้องที่เก็บภายใน <%= held.length %> รายการ
        </summary>

        <p class="text-sm text-gray-500 mt-3">
          พบข้อมูลละเอียดอ่อน/เรื่องบุคคล หรือยังไม่มีอาการที่ระบบรองรับ
          คำร้องยังดำเนินการตามปกติ ไม่ได้ถูกปฏิเสธ
        </p>

        <div class="mt-3 flex flex-col">
          <% held.forEach(r => { %>
            <a href="/admin/requests/<%= r.id %>"
               class="py-2 border-b border-gray-100 last:border-0 text-sm hover:text-[#1F2A8A] hover:underline break-words">
              <span class="font-semibold"><%= r.code %></span> — <%= r.title %>
            </a>
          <% }) %>
        </div>
      </details>

    </section>
  </main>
</div>

</body>
</html>