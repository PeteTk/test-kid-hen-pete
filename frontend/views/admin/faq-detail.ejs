<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <title>KIDHEN | <%= title %></title>
  <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-[#EEEDEA]">

<!-- แก้: ตรวจและแก้ย้อนหลัง ไม่มีปุ่มอนุมัติหรือปิดงานรวม -->
<div class="flex min-h-screen">
  <%- include("../partials/sidebar-admin") %>

  <main class="flex-1 min-w-0">
    <%- include("../partials/topbar") %>

    <section class="p-4">
      <div class="bg-white rounded-xl p-6">

        <a href="/admin/faq"
           class="inline-block bg-[#F6A85A]
                  rounded-full px-4 py-2">
          ← ย้อนกลับ
        </a>

        <h2 class="mt-5 text-xl font-bold text-[#1F2A8A]">
          รายละเอียดหัวข้อสรุป
        </h2>

        <p class="mt-3">
          <%= item.type %>
          · <%= item.location %>
        </p>

        <p class="mt-2 text-sm">
          รอดำเนินการ
          <%= item.counts["รอดำเนินการ"] %>
          · กำลังดำเนินการ
          <%= item.counts["กำลังดำเนินการ"] %>
          · เสร็จสิ้น
          <%= item.counts["เสร็จสิ้น"] %>
        </p>

        <!-- เพิ่ม: แก้ข้อความได้หลังเผยแพร่ -->
        <form
          method="POST"
          action="/admin/faq/topics/<%= item.id %>/save"
          class="mt-6 flex flex-col gap-4">

          <input type="hidden"
                 name="_csrf"
                 value="<%= aiCsrf %>">

          <label class="font-semibold text-[#1F2A8A]">
            หัวข้อ

            <input name="title"
                   value="<%= item.title %>"
                   required
                   maxlength="200"
                   class="mt-2 w-full border rounded-lg p-3">
          </label>

          <label class="font-semibold text-[#1F2A8A]">
            สรุปอาการ

            <textarea
              name="summary"
              required
              maxlength="1200"
              rows="4"
              class="mt-2 w-full rounded-xl
                     border-4 border-[#1E9BFF] p-4"
            ><%= item.summary %></textarea>
          </label>

          <p class="text-xs text-gray-500">
            ข้อความนี้เผยแพร่แก่ผู้ใช้
            ตรวจไม่ให้มีข้อมูลส่วนบุคคล
            และไม่ใส่สถานะที่ขัดกับคำร้องจริง
          </p>

          <button class="self-end bg-[#F6A85A]
                         rounded-full px-6 py-2">
            บันทึกการแก้ไข
          </button>
        </form>

        <!-- เพิ่ม: ซ่อนแทนลบ -->
        <form
          method="POST"
          action="/admin/faq/topics/<%= item.id %>/visibility"
          class="mt-4 text-right">

          <input type="hidden"
                 name="_csrf"
                 value="<%= aiCsrf %>">

          <input
            type="hidden"
            name="published"
            value="<%= item.published
              ? 'false' : 'true' %>">

          <button class="bg-gray-200 rounded-full px-6 py-2">
            <%= item.published
              ? "ซ่อนหัวข้อนี้"
              : "เผยแพร่หัวข้อนี้" %>
          </button>
        </form>

        <h3 class="mt-8 font-bold text-[#1F2A8A]">
          คำร้องที่เกี่ยวข้อง
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          แต่ละคำร้องยังเป็นงานแยกกัน
          เปลี่ยนสถานะจากหน้าจัดการคำร้องเดิม
        </p>

        <% reports.forEach(r => { %>
          <div class="mt-4 border-t pt-4">
            <a href="/admin/requests/<%= r.id %>"
               class="text-[#1F2A8A] underline">
              <%= r.code %> — <%= r.title %>
            </a>

            <p class="mt-2 text-sm">
              <%= r.location %>
              · <%= r.status %>
            </p>
          </div>
        <% }) %>

      </div>
    </section>
  </main>
</div>

</body>
</html>