<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KIDHEN | <%= title %></title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-[#EEEDEA]">

<%
  const ROLE_LABEL = { ADMIN: "Admin", STAFF: "Staff", USER: "User" };
  const ROLE_STYLE = {
    ADMIN: "bg-[#FDDCDC] text-[#E01E1E]",
    STAFF: "bg-[#DCE8FD] text-[#1F2A8A]",
    USER:  "bg-[#E3FBD2] text-[#3A8A12]",
  };
%>

<div class="flex min-h-screen">
  <%- include("../partials/sidebar-admin") %>

  <main class="flex-1 min-w-0">
    <%- include("../partials/topbar") %>

    <section class="p-4 lg:p-6">
      <div class="bg-white p-4 lg:p-6 min-h-[640px] flex flex-col gap-5 lg:gap-6">

        <!-- การ์ดสรุป -->
        <div class="grid grid-cols-3 gap-3 lg:gap-6">
          <div class="h-[80px] lg:h-[92px] rounded-2xl bg-[#EEF3FF] flex flex-col items-center justify-center text-center px-2">
            <p class="text-xs lg:text-sm font-semibold">ผู้ใช้งานทั้งหมด</p>
            <p class="text-2xl lg:text-3xl font-bold mt-1"><%= stats.total %></p>
          </div>
          <div class="h-[80px] lg:h-[92px] rounded-2xl bg-[#FDF1EA] flex flex-col items-center justify-center text-center px-2">
            <p class="text-xs lg:text-sm font-semibold">ผู้ดูแลระบบ</p>
            <p class="text-2xl lg:text-3xl font-bold mt-1"><%= stats.admin %></p>
          </div>
          <div class="h-[80px] lg:h-[92px] rounded-2xl bg-[#FFF6EB] flex flex-col items-center justify-center text-center px-2">
            <p class="text-xs lg:text-sm font-semibold">เจ้าหน้าที่</p>
            <p class="text-2xl lg:text-3xl font-bold mt-1"><%= stats.staff %></p>
          </div>
        </div>

        <!-- ค้นหา + กรองบทบาท -->
        <form method="GET" action="/admin/users" class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
          <input type="text" name="q" value="<%= filters.q %>" placeholder="ค้นหาชื่อหรืออีเมล"
                 class="w-full sm:w-[320px] h-10 px-5 rounded-lg border border-gray-400 text-sm focus:outline-none focus:ring-2 focus:ring-[#1F2A8A]">

          <select name="role" onchange="this.form.submit()"
                  class="h-10 w-full sm:w-[140px] px-3 rounded-lg border border-gray-400 bg-white text-sm sm:ml-auto">
            <option value="">ทุกบทบาท</option>
            <% ROLES.forEach(r => { %>
              <option value="<%= r %>" <%= filters.role === r ? "selected" : "" %>><%= ROLE_LABEL[r] %></option>
            <% }) %>
          </select>

          <!-- เพิ่ม (3b-3): Admin เพิ่มผู้ใช้ (UC-09) -->
          <a href="/admin/users/new"
             class="h-10 px-5 rounded-lg bg-[#F6A85A] border border-black text-sm font-bold flex items-center justify-center whitespace-nowrap hover:bg-[#F39A3E]">
            + เพิ่มผู้ใช้
          </a>
        </form>

        <% if (list.length === 0) { %>
          <p class="py-10 text-center text-gray-400">ไม่พบผู้ใช้</p>
        <% } else { %>

          <!-- ===== คอม / แท็บเล็ต: ตาราง ===== -->
          <div class="hidden md:block overflow-x-auto">
            <table class="w-full text-sm border border-gray-200">
              <thead class="bg-[#EEEFF3] text-gray-600">
                <tr>
                  <th class="text-left py-3 px-4 font-medium border border-gray-200 w-[18%]">ชื่อผู้ใช้</th>
                  <th class="text-left py-3 px-4 font-medium border border-gray-200 w-[20%]">อีเมล</th>
                  <th class="text-left py-3 px-4 font-medium border border-gray-200 w-[18%]">คณะ</th>
                  <th class="text-left py-3 px-4 font-medium border border-gray-200 w-[14%]">ฝ่าย</th>
                  <th class="text-left py-3 px-4 font-medium border border-gray-200 w-[14%]">บทบาท</th>
                  <th class="text-center py-3 px-4 font-medium border border-gray-200 w-[16%]">จัดการ</th>
                </tr>
              </thead>
              <tbody>
                <% list.forEach(u => { %>
                  <tr class="hover:bg-[#F7F8FB]">
                    <td class="py-2.5 px-4 border border-gray-200 font-semibold">
                      <%= u.name %>
                      <% if (!u.active) { %><span class="ml-1 text-xs text-gray-400">(ปิดใช้งาน)</span><% } %>
                    </td>
                    <td class="py-2.5 px-4 border border-gray-200 break-all"><%= u.email %></td>
                    <td class="py-2.5 px-4 border border-gray-200"><%= u.facultyLabel %></td>
                    <td class="py-2.5 px-4 border border-gray-200"><%= u.departmentLabel %></td>
                    <td class="py-2.5 px-4 border border-gray-200">
                      <span class="inline-block w-[90px] py-0.5 rounded-full text-xs font-semibold text-center <%= ROLE_STYLE[u.role] %>">
                        <%= ROLE_LABEL[u.role] %>
                      </span>
                    </td>
                    <td class="py-2.5 px-4 border border-gray-200">
                      <div class="flex items-center justify-center gap-2">
                        <a href="/admin/users/<%= u.id %>"
                           class="px-3 py-0.5 rounded-md border border-gray-500 bg-white text-xs font-semibold hover:bg-gray-100">
                          แก้ไข
                        </a>
                        <% if (u.id !== currentUser.id) { %>
                          <form method="POST" action="/admin/users/<%= u.id %>/delete"
                                onsubmit="return confirm('ต้องการลบผู้ใช้ &quot;<%= u.name %>&quot; ใช่หรือไม่?')">
                            <button type="submit"
                                    class="px-4 py-0.5 rounded-md bg-[#FDDCDC] text-[#E01E1E] text-xs font-semibold hover:bg-[#FBC6C6]">
                              ลบ
                            </button>
                          </form>
                        <% } else { %>
                          <span class="px-4 py-0.5 text-xs text-gray-400" title="ลบบัญชีตัวเองไม่ได้">ลบ</span>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <!-- ===== มือถือ: การ์ด ===== -->
          <div class="md:hidden flex flex-col gap-3">
            <% list.forEach(u => { %>
              <div class="rounded-xl border border-gray-200 p-4">
                <div class="flex items-start justify-between gap-2">
                  <p class="font-bold"><%= u.name %></p>
                  <span class="shrink-0 inline-block w-[70px] py-0.5 rounded-full text-xs font-semibold text-center <%= ROLE_STYLE[u.role] %>">
                    <%= ROLE_LABEL[u.role] %>
                  </span>
                </div>

                <p class="text-sm text-gray-600 mt-1 break-all"><%= u.email %></p>
                <p class="text-xs text-gray-500 mt-1"><%= u.facultyLabel %> · <%= u.departmentLabel %></p>

                <div class="flex justify-end gap-2 mt-3">
                  <a href="/admin/users/<%= u.id %>"
                     class="px-4 py-1 rounded-md border border-gray-500 bg-white text-xs font-semibold hover:bg-gray-100">
                    แก้ไข
                  </a>
                  <% if (u.id !== currentUser.id) { %>
                    <form method="POST" action="/admin/users/<%= u.id %>/delete"
                          onsubmit="return confirm('ต้องการลบผู้ใช้ &quot;<%= u.name %>&quot; ใช่หรือไม่?')">
                      <button type="submit"
                              class="px-4 py-1 rounded-md bg-[#FDDCDC] text-[#E01E1E] text-xs font-semibold hover:bg-[#FBC6C6]">
                        ลบ
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>

        <% } %>

      </div>
    </section>
  </main>
</div>

</body>
</html>