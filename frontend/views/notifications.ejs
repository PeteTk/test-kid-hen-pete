<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KIDHEN | <%= title %></title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-[#EEEDEA]">

<%
  const TABS = [
    { key: "all",     label: "ทั้งหมด" },
    { key: "unread",  label: "ยังไม่ได้อ่าน" },
    { key: "request", label: role === "user" ? "คำร้องของฉัน" : "คำร้อง" },
  ];
%>

<div class="flex min-h-screen">
  <%- include(`partials/sidebar-${role}`) %>

  <main class="flex-1 min-w-0">
    <%- include("partials/topbar") %>

    <section class="p-6 flex flex-col gap-6">

      <!-- แท็บ -->
      <div class="flex flex-wrap gap-4 px-2">
        <% TABS.forEach(t => { %>
          <a href="/notifications?tab=<%= t.key %>"
             class="w-[130px] h-9 rounded-md text-sm flex items-center justify-center
                    <%= tab === t.key
                        ? 'bg-[#F6A85A] text-white font-semibold'
                        : 'bg-white border border-gray-400 text-gray-700 hover:bg-gray-50' %>">
            <%= t.label %>
          </a>
        <% }) %>
      </div>

      <!-- รายการแจ้งเตือน -->
      <div class="flex flex-col gap-1 bg-[#E2E1DD] min-h-[560px]">

        <% if (list.length === 0) { %>
          <div class="bg-white flex-1 flex items-center justify-center text-base text-gray-400">
            ไม่มีการแจ้งเตือน
          </div>
        <% } %>

        <% list.forEach(n => { %>
          <a href="/notifications/<%= n.id %>"
             class="flex items-center gap-5 px-5 h-[84px] border-l-4 hover:brightness-95
                    <%= n.read ? 'bg-white border-transparent' : 'bg-[#FFF6EB] border-[#F6A85A]' %>">

            <div class="relative w-12 h-12 shrink-0 rounded-full bg-[#E2E2E2] flex items-center justify-center">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/>
              </svg>
              <% if (!n.read) { %>
                <span class="absolute top-0 right-0 w-3 h-3 rounded-full bg-red-600 border-2 border-white"></span>
              <% } %>
            </div>

            <div class="flex-1 min-w-0">
              <p class="text-base truncate <%= n.read ? 'font-medium' : 'font-bold' %>"><%= n.title %></p>
              <p class="text-sm text-gray-500 mt-1 truncate"><%= n.message %></p>
            </div>

            <% if (n.status) { %>
              <div class="hidden md:block shrink-0">
                <%- include("partials/status-badge", { status: n.status }) %>
              </div>
            <% } %>

            <p class="hidden md:block w-[190px] shrink-0 text-right text-sm text-gray-500">
              <%= n.time %> &nbsp;&gt;
            </p>
          </a>
        <% }) %>

      </div>
    </section>
  </main>
</div>
</body>
</html>