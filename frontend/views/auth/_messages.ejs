<% if (typeof notice !== "undefined" && notice) { %>
    <p class="text-sm text-[#3A8A12] bg-[#E3FBD2] border border-[#8BDA5B] rounded-lg px-4 py-2 text-center"><%= notice %></p>
<% } %>
<% if (typeof error !== "undefined" && error) { %>
    <p class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-4 py-2 text-center"><%= error %></p>
<% } %>
