# คัดลอกเป็น backend/.env แล้วแก้ค่า (ไฟล์ .env ถูก .gitignore ไว้แล้ว)
# บน AWS ไม่ต้องใช้ไฟล์นี้ — Terraform เขียน /etc/kidhen.env ให้
# รายการและความหมายทั้งหมดอยู่ใน backend/config.js

PORT=3000
SESSION_SECRET=ใส่อะไรก็ได้ตอนพัฒนา

# วิธีเข้าสู่ระบบ (3b-2)
#   local = ฟอร์มอีเมล/username + รหัสผ่าน (ค่าเริ่มต้นในเครื่อง)
#           SQLite จะมีบัญชีทดลอง: admin / staff / staff2 / user / user2  รหัส 1234
#   alb   = อ่านตัวตนจาก header ของ ALB+Cognito (ค่าเริ่มต้นเมื่อ NODE_ENV=production)
# AUTH_MODE=local

# สถานะคำร้องเปลี่ยน (3c)
#   local       = เว็บเขียนแจ้งเตือนเอง (ค่าเริ่มต้นในเครื่อง ไม่ต้องต่อ AWS)
#   eventbridge = ส่ง TicketStatusChanged เข้า EventBridge → Lambda status.py (ค่าเริ่มต้นบน AWS)
# EVENTS_MODE=local

# ใช้เมื่อ AUTH_MODE=alb (บน AWS Terraform เขียนให้ใน /etc/kidhen.env)
# COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/<user pool id>
# COGNITO_CLIENT_ID=
# COGNITO_USER_POOL_ID=
# COGNITO_DOMAIN=kid-hen.auth.us-east-1.amazoncognito.com
# APP_BASE_URL=https://kid-hen.app
# ALB_ARN=

# ฐานข้อมูลในเครื่อง = SQLite (ไม่ต้องติดตั้งอะไร)
# DB_DRIVER=sqlite
# SQLITE_PATH=data/kidhen.sqlite

# ทดสอบกับ MySQL (ไม่บังคับ)
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=kidhen
# DB_USER=kidhen_admin
# DB_PASSWORD=
# DB_SSL=false

# AI (ไม่บังคับ)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
