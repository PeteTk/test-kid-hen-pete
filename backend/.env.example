# คัดลอกเป็น backend/.env แล้วแก้ค่า (ไฟล์ .env ถูก .gitignore ไว้แล้ว — ห้าม commit)
# บน AWS ไม่ต้องใช้ไฟล์นี้: Terraform เขียน /etc/kidhen.env ให้ตอน EC2 บูต
# ความหมายและการตรวจค่าทั้งหมดอยู่ใน backend/config.js

PORT=3000
SESSION_SECRET=ใส่อะไรก็ได้ตอนพัฒนา

# ---------------- โหมด (ในเครื่องใช้ค่าเริ่มต้นได้เลย ไม่ต้องต่อ AWS) ----------------
# วิธีเข้าสู่ระบบ
#   local   = ฟอร์มอีเมล/username + รหัสผ่านใน SQLite (ค่าเริ่มต้นในเครื่อง, บัญชีทดลองรหัส 1234)
#   cognito = หน้า login ของเว็บคุยกับ Cognito + Google (บน AWS)
#   alb     = อ่านตัวตนจาก header ของ ALB+Cognito (ไม่ใช้แล้ว เก็บไว้เผื่อ)
# AUTH_MODE=local

# สถานะคำร้องเปลี่ยน / ปุ่มประมวลผล AI
#   local       = เว็บเขียนแจ้งเตือนและเรียก Gemini เอง
#   eventbridge = PutEvents → EventBridge → Lambda (บน AWS)
# EVENTS_MODE=local

# ไฟล์แนบ / รูปโปรไฟล์
#   local = frontend/public/uploads
#   s3    = S3 ผ่าน pre-signed URL (บน AWS, ต้องมี S3_BUCKET + สิทธิ์ IAM)
# STORAGE_MODE=local

# บัญชีทดลอง 40 บัญชีบน RDS (Terraform ตั้งเมื่อ create_test_accounts = true)
# SEED_TEST_ACCOUNTS=false

# ---------------- ฐานข้อมูล ----------------
# ในเครื่อง = SQLite (ไม่ต้องติดตั้งอะไร)
# DB_DRIVER=sqlite
# SQLITE_PATH=data/kidhen.sqlite

# MySQL (บน AWS = RDS)
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=kidhen
# DB_USER=kidhen_admin
# DB_PASSWORD=
# DB_SSL=false

# ---------------- AWS (บน AWS Terraform ตั้งให้ทั้งหมด) ----------------
# AWS_REGION=us-east-1
# APP_BASE_URL=https://kid-hen.app        # ในเครื่อง: http://localhost:3000
# HEALTH_CHECK_PATH=/health
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=
# COGNITO_DOMAIN=kid-hen.auth.us-east-1.amazoncognito.com
# COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/<user pool id>
# S3_BUCKET=
# SNS_TOPIC_ARN=                          # อีเมลทีม Staff/Admin
# STUDENT_SNS_TOPIC_ARN=                  # อีเมลแจ้งสถานะคำร้องถึงคนร้องเรียน (ว่าง = ไม่ส่ง)
# EVENT_SOURCE=kidhen.app
# ALB_ARN=

# ---------------- AI (ไม่บังคับ: ในเครื่องใช้ตอน EVENTS_MODE=local) ----------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# AI_TIMEOUT_MS=60000
